-      "${work_dir}/espresso-arm64" \
-      "${work_dir}/espresso-x64.checksum" \
-      "${work_dir}/espresso-arm64.checksum"
+      --notes "Pre-built espresso binaries for the udb gem (Linux and macOS, x64 and arm64). Commit: ${espresso_commit}" \
+      "${release_assets[@]}"
   fi
 
