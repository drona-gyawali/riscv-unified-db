     echo "ERROR: Invalid ${version_file}: expected ${tool}-<7-to-40-char-hex-commit>, got '${version}'" >&2
     exit 1
@@ -114,6 +114,16 @@ do_update_espresso() {
   local work_dir
   work_dir=$(mktemp -d --tmpdir="$PWD" build-espresso.XXXXXX)
 
+  local current_os
+  case "$(uname -s)" in
+    Linux)  current_os="Linux" ;;
+    Darwin) current_os="Mac" ;;
+    *)
+      echo "ERROR: Unsupported OS: $(uname -s)" >&2
+      exit 1
+      ;;
+  esac
+
   if [ "${native_only}" = "yes" ]; then
     # Detect native architecture
     local native_arch
@@ -129,74 +139,85 @@ do_update_espresso() {
